typedef struct {
	CreatureDialogData* data;
	int result;
	BOOL done;
	HWND hwnd_name;
	HWND hwnd_init;
	HWND hwnd_ok;
	HWND hwnd_cancel;
} DialogState;

LRESULT CALLBACK DialogWindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	DialogState* state = (DialogState*)GetWindowLongPtr(hwnd, GWLP_USERDATA);

	switch (msg) {
		case WM_CREATE: {
			CREATESTRUCT* cs = (CREATESTRUCT*)lParam;
			state = (DialogState*)cs->lpCreateParams;
			SetWindowLongPtr(hwnd, GWLP_USERDATA, (LONG_PTR)state);

			HWND hwnd_label_name = CreateWindow("STATIC", "Name:",
				WS_CHILD | WS_VISIBLE, 10, 10, 50, 20, hwnd, NULL, NULL, NULL);

			state->hwnd_name = CreateWindow("EDIT", "",
				WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 70, 10, 210, 20,
				hwnd, (HMENU)1001, NULL, NULL);

			HWND hwnd_label_init = CreateWindow("STATIC", "Initiative:",
				WS_CHILD | WS_VISIBLE, 10, 40, 60, 20, hwnd, NULL, NULL, NULL);

			state->hwnd_init = CreateWindow("EDIT", "10",
				WS_CHILD | WS_VISIBLE | WS_BORDER | ES_NUMBER | WS_TABSTOP, 70, 40, 210, 20,
				hwnd, (HMENU)1002, NULL, NULL);

			state->hwnd_ok = CreateWindow("BUTTON", "OK",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | WS_TABSTOP, 80, 80, 70, 25,
				hwnd, (HMENU)IDOK, NULL, NULL);

			state->hwnd_cancel = CreateWindow("BUTTON", "Cancel",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | WS_TABSTOP, 160, 80, 70, 25,
				hwnd, (HMENU)IDCANCEL, NULL, NULL);

			SetWindowText(state->hwnd_name, state->data->name);
			char init_str[16];
			sprintf_s(init_str, sizeof(init_str), "%d", state->data->initiative);
			SetWindowText(state->hwnd_init, init_str);

			SetFocus(state->hwnd_name);
			SendMessage(state->hwnd_name, EM_SETSEL, 0, -1);
			return 0;
		}

		case WM_KEYDOWN: {
			if (wParam == VK_TAB) {
				HWND hwnd_focus = GetFocus();
				HWND hwnd_next = NULL;

				if (hwnd_focus == state->hwnd_name) {
					hwnd_next = state->hwnd_init;
				} else if (hwnd_focus == state->hwnd_init) {
					hwnd_next = state->hwnd_ok;
				} else if (hwnd_focus == state->hwnd_ok) {
					hwnd_next = state->hwnd_cancel;
				} else if (hwnd_focus == state->hwnd_cancel) {
					hwnd_next = state->hwnd_name;
				}

				if (hwnd_next) {
					SetFocus(hwnd_next);
					if (hwnd_next == state->hwnd_name || hwnd_next == state->hwnd_init) {
						SendMessage(hwnd_next, EM_SETSEL, 0, -1);
					}
				}
				return 0;
			}
			break;
		}

		case WM_COMMAND: {
			int control_id = LOWORD(wParam);

			if (control_id == IDOK) {
				char name_buf[MAX_NAME_LENGTH];
				GetWindowText(state->hwnd_name, name_buf, MAX_NAME_LENGTH);

				char init_buf[16];
				GetWindowText(state->hwnd_init, init_buf, sizeof(init_buf));

				if (strlen(name_buf) > 0) {
					strcpy_s(state->data->name, MAX_NAME_LENGTH, name_buf);
					state->data->initiative = atoi(init_buf);
					state->result = IDOK;
					state->done = TRUE;
					PostMessage(hwnd, WM_CLOSE, 0, 0);
				} else {
					MessageBox(hwnd, "Please enter a creature name", "Invalid Input", MB_ICONWARNING);
					SetFocus(state->hwnd_name);
				}
				return 0;
			}
			else if (control_id == IDCANCEL) {
				state->result = IDCANCEL;
				state->done = TRUE;
				PostMessage(hwnd, WM_CLOSE, 0, 0);
				return 0;
			}
			break;
		}

		case WM_CLOSE:
			DestroyWindow(hwnd);
			return 0;

		case WM_CTLCOLORDLG:
		case WM_CTLCOLORLISTBOX:
		case WM_CTLCOLOREDIT:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			break;
		}
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

LRESULT CALLBACK EffectSelectDialogProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	EffectSelectDialogState* state = (EffectSelectDialogState*)GetWindowLongPtr(hwnd, GWLP_USERDATA);

	switch (msg) {
		case WM_CREATE: {
			CREATESTRUCT* cs = (CREATESTRUCT*)lParam;
			state = (EffectSelectDialogState*)cs->lpCreateParams;
			SetWindowLongPtr(hwnd, GWLP_USERDATA, (LONG_PTR)state);

			state->hwnd_list = CreateWindow("LISTBOX", "",
				WS_CHILD | WS_VISIBLE | WS_BORDER | LBS_NOTIFY,
				10, 10, 300, 200, hwnd, (HMENU)ID_EFFECTS_LIST_SELECT, NULL, NULL);

			CreateWindow("BUTTON", "OK",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW,
				90, 220, 60, 28, hwnd, (HMENU)ID_EFFECTS_OK, NULL, NULL);
			CreateWindow("BUTTON", "Cancel",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW,
				170, 220, 80, 28, hwnd, (HMENU)ID_EFFECTS_CANCEL, NULL, NULL);

			if (state->db) {
				for (int i = 0; i < state->db->count; i++) {
					SendMessage(state->hwnd_list, LB_ADDSTRING, 0, (LPARAM)state->db->effects[i].name);
				}
			}
			return 0;
		}

		case WM_COMMAND: {
			int control_id = LOWORD(wParam);
			int notify = HIWORD(wParam);

			if (control_id == ID_EFFECTS_CANCEL) {
				state->accepted = FALSE;
				state->done = TRUE;
				DestroyWindow(hwnd);
				return 0;
			}
			if (control_id == ID_EFFECTS_OK) {
				int sel = (int)SendMessage(state->hwnd_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR) {
					state->selected_index = sel;
					state->accepted = TRUE;
					state->done = TRUE;
					DestroyWindow(hwnd);
				}
				return 0;
			}
			if (control_id == ID_EFFECTS_LIST_SELECT && notify == LBN_DBLCLK) {
				int sel = (int)SendMessage(state->hwnd_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR) {
					state->selected_index = sel;
					state->accepted = TRUE;
					state->done = TRUE;
					DestroyWindow(hwnd);
				}
				return 0;
			}
			break;
		}

		case WM_CTLCOLORLISTBOX:
		case WM_CTLCOLORDLG:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			break;
		}

		case WM_CLOSE:
			if (state) {
				state->accepted = FALSE;
				state->done = TRUE;
			}
			DestroyWindow(hwnd);
			return 0;
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

static int show_effect_select_dialog(HWND parent, EffectsDatabase* db) {
	static BOOL class_registered = FALSE;
	if (!class_registered) {
		WNDCLASS wc = { 0 };
		wc.lpfnWndProc = EffectSelectDialogProc;
		wc.lpszClassName = "EffectSelectDialogClass";
		wc.hInstance = GetModuleHandle(NULL);
		wc.hCursor = LoadCursor(NULL, IDC_ARROW);
		wc.hbrBackground = g_brush_bg;
		RegisterClass(&wc);
		class_registered = TRUE;
	}

	EffectSelectDialogState state;
	state.db = db;
	state.selected_index = -1;
	state.done = FALSE;
	state.accepted = FALSE;
	state.hwnd_list = NULL;

	HWND hwnd_dialog = CreateWindowEx(WS_EX_DLGMODALFRAME,
		"EffectSelectDialogClass", "Select Effect",
		WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU,
		350, 220, 330, 290,
		parent, NULL, GetModuleHandle(NULL), &state);

	if (!hwnd_dialog) return -1;

	ShowWindow(hwnd_dialog, SW_SHOW);
	UpdateWindow(hwnd_dialog);

	MSG msg;
	while (!state.done && GetMessage(&msg, NULL, 0, 0)) {
		if (msg.hwnd == hwnd_dialog || IsChild(hwnd_dialog, msg.hwnd)) {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}
		else {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}
	}

	if (!state.accepted) return -1;
	return state.selected_index;
}

int show_creature_dialog(HWND parent, CreatureDialogData* data) {
	static BOOL class_registered = FALSE;

	if (!class_registered) {
		WNDCLASS wc = { 0 };
		wc.lpfnWndProc = DialogWindowProc;
		wc.lpszClassName = "CreatureDialogClass";
		wc.hInstance = GetModuleHandle(NULL);
		wc.hCursor = LoadCursor(NULL, IDC_ARROW);
		wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
		wc.hIcon = LoadIcon(NULL, IDI_APPLICATION);
		RegisterClass(&wc);
		class_registered = TRUE;
	}

	DialogState state;
	state.data = data;
	state.result = IDCANCEL;
	state.done = FALSE;

	HWND hwnd_dialog = CreateWindowEx(WS_EX_DLGMODALFRAME,
		"CreatureDialogClass", "Add name",
		WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU,
		300, 200, 300, 150,
		parent, NULL, GetModuleHandle(NULL), &state);

	if (!hwnd_dialog) return IDCANCEL;

	ShowWindow(hwnd_dialog, SW_SHOW);
	UpdateWindow(hwnd_dialog);

	MSG msg;
	while (GetMessage(&msg, NULL, 0, 0)) {
		if (msg.hwnd == hwnd_dialog || IsChild(hwnd_dialog, msg.hwnd)) {
			if (!IsDialogMessage(hwnd_dialog, &msg)) {
				TranslateMessage(&msg);
				DispatchMessage(&msg);
			}
		} else {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}

		if (state.done) {
			break;
		}
	}

	return state.result;
}

LRESULT CALLBACK MainWindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	AppState* app = &g_app_state;

	switch (msg) {
		case WM_CREATE:
			ui_create_controls(hwnd);
			ui_update_round_label();
			ui_update_initiative_list();
			ui_update_effects_list();
			return 0;

		case WM_COMMAND: {
			int control_id = LOWORD(wParam);
			int notification = HIWORD(wParam);

			if (notification == LBN_SELCHANGE && control_id == 2001) {
				int sel = (int)SendMessage(app->hwnd_initiative_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR) {
					app->selected_creature_idx = sel;
					ui_update_effects_list();
				}
				return 0;
			}

			if (notification == LBN_DBLCLK && control_id == 2001) {
				int sel = (int)SendMessage(app->hwnd_initiative_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR && app->encounter && sel < app->encounter->creature_count) {
					Creature* c = &app->encounter->creatures[sel];
					CreatureDialogData dialog_data;
					strcpy_s(dialog_data.name, MAX_NAME_LENGTH, c->name);
					dialog_data.initiative = c->initiative;
					dialog_data.edit_mode = 1;
					dialog_data.creature_idx = sel;

					if (show_creature_dialog(hwnd, &dialog_data) == IDOK) {
						strcpy_s(c->name, MAX_NAME_LENGTH, dialog_data.name);
						c->initiative = dialog_data.initiative;
						ui_save_creature_at_index(app, sel);
						ui_update_initiative_list();
						ui_update_effects_list();
					}
				}
				return 0;
			}

			switch (control_id) {
				case 1001:
					if (app->encounter) {
						encounter_next_turn(app->encounter);
						ui_save_all_creatures(app);
						ui_update_initiative_list();
						ui_update_round_label();
						ui_update_effects_list();
					}
					return 0;

				case 1002:
					if (app->encounter) {
						encounter_sort_by_initiative(app->encounter);
						ui_update_initiative_list();
						ui_update_effects_list();
					}
					return 0;

				case 1003:
					if (app->encounter) {
						CreatureDialogData dialog_data;
						strcpy_s(dialog_data.name, MAX_NAME_LENGTH, "New Creature");
						dialog_data.initiative = 10;
						dialog_data.edit_mode = 0;
						dialog_data.creature_idx = -1;

						if (show_creature_dialog(hwnd, &dialog_data) == IDOK) {
							int added_idx = encounter_add_creature(app->encounter, dialog_data.name, dialog_data.initiative);
							if (added_idx >= 0) {
								app->selected_creature_idx = added_idx;
								ui_save_creature_at_index(app, added_idx);
							}
							ui_update_initiative_list();
							ui_update_effects_list();
						}
					}
					return 0;

				case 1004: {
					int creature_idx = ui_get_display_creature_index(app);
					if (app->encounter && creature_idx >= 0 && creature_idx < app->encounter->creature_count) {
						if (!app->effects_db || app->effects_db->count <= 0) {
							MessageBox(hwnd, "No effects were loaded from effects.json.", "Effects Not Available", MB_ICONWARNING);
							return 0;
						}

						int selected_effect = show_effect_select_dialog(hwnd, app->effects_db);
						if (selected_effect >= 0) {
							const EffectDefinition* effect = effects_db_get_effect(app->effects_db, selected_effect);
							if (effect) {
								Creature* c = &app->encounter->creatures[creature_idx];
								creature_add_effect(c, effect->name, effect->base_duration);
								app->selected_creature_idx = creature_idx;
								ui_save_creature_at_index(app, creature_idx);
								ui_update_effects_list();
								ui_update_initiative_list();
							}
						}
					}
					return 0;
				}

				case 1005: {
					int creature_idx = ui_get_display_creature_index(app);
					if (app->encounter && creature_idx >= 0 && creature_idx < app->encounter->creature_count) {
						int sel = (int)SendMessage(app->hwnd_effects_list, LB_GETCURSEL, 0, 0);
						if (sel != LB_ERR && sel > 0) {
							Creature* c = &app->encounter->creatures[creature_idx];
							creature_remove_effect(c, sel - 1);
							app->selected_creature_idx = creature_idx;
							ui_save_creature_at_index(app, creature_idx);
							ui_update_effects_list();
							ui_update_initiative_list();
						}
					}
					return 0;
				}

				case 1006: {
					char dice_type_str[16];
					char count_str[16];
					char mod_str[16];
					GetWindowText(app->hwnd_dice_type, dice_type_str, sizeof(dice_type_str));
					GetWindowText(app->hwnd_dice_count, count_str, sizeof(count_str));
					GetWindowText(app->hwnd_modifier, mod_str, sizeof(mod_str));

					int count = atoi(count_str);
					int modifier = atoi(mod_str);
					DiceType type = dice_type_from_string(dice_type_str);
					RollResult* result = roll_dice(type, count, modifier);

					if (result) {
						char results_text[4096] = "";
						for (int i = 0; i < result->count; i++) {
							char line[256];
							sprintf_s(line, sizeof(line), "[ %d (+%d) = %d ]\r\n", result->individual_rolls[i], result->modifier, result->modified_rolls[i]);
							strcat_s(results_text, sizeof(results_text), line);
						}

						char total_line[256];
						sprintf_s(total_line, sizeof(total_line), "\r\nTotal: %d", result->total);
						strcat_s(results_text, sizeof(results_text), total_line);
						SetWindowText(app->hwnd_roll_results, results_text);
						roll_result_destroy(result);
					}
					return 0;
				}
			}
			break;
		}

		case WM_DESTROY:
			PostQuitMessage(0);
			return 0;

		case WM_CTLCOLORDLG:
		case WM_CTLCOLORLISTBOX:
		case WM_CTLCOLOREDIT:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			break;
		}
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

int ui_init_and_run(void) {
	AppState* app = &g_app_state;

	app->encounter = encounter_create();
	if (!app->encounter) return -1;

	app->effects_db = effects_db_create();
	if (!app->effects_db) {
		encounter_destroy(app->encounter);
		return -1;
	}

	if (ui_load_effects_db(app->effects_db) <= 0) {
		MessageBox(NULL, "Could not load resources\\effects.json from expected locations.", "Effects Load Error", MB_ICONWARNING);
	}

	app->selected_creature_idx = -1;

	ui_save_all_creatures(app);
	ui_init_dark_mode();

	WNDCLASS wc = { 0 };
	wc.lpfnWndProc = MainWindowProc;
	wc.lpszClassName = "TurnForgeTrackerClass";
	wc.hInstance = GetModuleHandle(NULL);
	wc.hCursor = LoadCursor(NULL, IDC_ARROW);
	wc.hbrBackground = g_brush_bg;

	if (!RegisterClass(&wc)) {
		return -1;
	}

	app->hwnd_main = CreateWindow("TurnForgeTrackerClass", "Turn Forge Tracker",
		WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 700, 700,
		NULL, NULL, wc.hInstance, NULL);

	if (!app->hwnd_main) {
		return -1;
	}

	ShowWindow(app->hwnd_main, SW_SHOW);
	UpdateWindow(app->hwnd_main);

	MSG msg;
	while (GetMessage(&msg, NULL, 0, 0)) {
		TranslateMessage(&msg);
		DispatchMessage(&msg);
	}

	if (app->encounter) encounter_destroy(app->encounter);
	if (app->effects_db) effects_db_destroy(app->effects_db);
	ui_cleanup_dark_mode();

	return 0;
}

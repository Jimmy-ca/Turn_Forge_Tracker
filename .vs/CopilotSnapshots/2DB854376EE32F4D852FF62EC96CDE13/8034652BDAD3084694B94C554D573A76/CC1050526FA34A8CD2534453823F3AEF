		wc.hIcon = LoadIcon(NULL, IDI_APPLICATION);
		RegisterClass(&wc);
		class_registered = TRUE;
	}

	DialogState state;
	state.data = data;
	state.result = IDCANCEL;
	state.done = FALSE;

	int dialog_x = 300;
	int dialog_y = 200;
	if (data && data->edit_mode == 0) {
		dialog_y = g_next_creature_dialog_y;
		g_next_creature_dialog_y += 120;
		if (g_next_creature_dialog_y > 560) {
			g_next_creature_dialog_y = 200;

typedef struct {
	CreatureDialogData* data;
	int result;
	BOOL done;
	HWND hwnd_name;
	HWND hwnd_init;
	HWND hwnd_dex;
	HWND hwnd_ok;
	HWND hwnd_cancel;
} DialogState;

LRESULT CALLBACK DialogWindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	DialogState* state = (DialogState*)GetWindowLongPtr(hwnd, GWLP_USERDATA);

	switch (msg) {
		case WM_CREATE: {
			CREATESTRUCT* cs = (CREATESTRUCT*)lParam;
			state = (DialogState*)cs->lpCreateParams;
			SetWindowLongPtr(hwnd, GWLP_USERDATA, (LONG_PTR)state);

			HWND hwnd_label_name = CreateWindow("STATIC", "Name:",
				WS_CHILD | WS_VISIBLE, 10, 10, 50, 20, hwnd, NULL, NULL, NULL);

			state->hwnd_name = CreateWindow("EDIT", "",
				WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 70, 10, 210, 20,
				hwnd, (HMENU)1001, NULL, NULL);

			HWND hwnd_label_init = CreateWindow("STATIC", "Initiative:",
				WS_CHILD | WS_VISIBLE, 10, 40, 60, 20, hwnd, NULL, NULL, NULL);

			state->hwnd_init = CreateWindow("EDIT", "10",
				WS_CHILD | WS_VISIBLE | WS_BORDER | ES_NUMBER | WS_TABSTOP, 70, 40, 210, 20,
				hwnd, (HMENU)1002, NULL, NULL);

			HWND hwnd_label_dex = CreateWindow("STATIC", "Dexterity:",
				WS_CHILD | WS_VISIBLE, 10, 70, 60, 20, hwnd, NULL, NULL, NULL);

			state->hwnd_dex = CreateWindow("EDIT", "0.0",
				WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 70, 70, 210, 20,
				hwnd, (HMENU)1003, NULL, NULL);

			state->hwnd_ok = CreateWindow("BUTTON", "OK",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | WS_TABSTOP, 80, 105, 70, 25,
				hwnd, (HMENU)IDOK, NULL, NULL);

			state->hwnd_cancel = CreateWindow("BUTTON", "Cancel",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | WS_TABSTOP, 160, 105, 70, 25,
				hwnd, (HMENU)IDCANCEL, NULL, NULL);

			SetWindowText(state->hwnd_name, state->data->name);
			char init_str[16];
			sprintf_s(init_str, sizeof(init_str), "%d", state->data->initiative);
			SetWindowText(state->hwnd_init, init_str);
			char dex_str[16];
			sprintf_s(dex_str, sizeof(dex_str), "%.1f", state->data->dexterity);
			SetWindowText(state->hwnd_dex, dex_str);

			SetFocus(state->hwnd_name);
			SendMessage(state->hwnd_name, EM_SETSEL, 0, -1);
			return 0;
		}

		case WM_KEYDOWN: {
			if (wParam == VK_TAB) {
				HWND hwnd_focus = GetFocus();
				HWND hwnd_next = NULL;

				if (hwnd_focus == state->hwnd_name) {
					hwnd_next = state->hwnd_init;
				} else if (hwnd_focus == state->hwnd_init) {
					hwnd_next = state->hwnd_dex;
				} else if (hwnd_focus == state->hwnd_dex) {
					hwnd_next = state->hwnd_ok;
				} else if (hwnd_focus == state->hwnd_ok) {
					hwnd_next = state->hwnd_cancel;
				} else if (hwnd_focus == state->hwnd_cancel) {
					hwnd_next = state->hwnd_name;
				}

				if (hwnd_next) {
					SetFocus(hwnd_next);
					if (hwnd_next == state->hwnd_name || hwnd_next == state->hwnd_init || hwnd_next == state->hwnd_dex) {
						SendMessage(hwnd_next, EM_SETSEL, 0, -1);
					}
				}
				return 0;
			}
			break;
		}

		case WM_COMMAND: {
			int control_id = LOWORD(wParam);

			if (control_id == IDOK) {
				char name_buf[MAX_NAME_LENGTH];
				GetWindowText(state->hwnd_name, name_buf, MAX_NAME_LENGTH);

				char init_buf[16];
				GetWindowText(state->hwnd_init, init_buf, sizeof(init_buf));
				char dex_buf[16];
				GetWindowText(state->hwnd_dex, dex_buf, sizeof(dex_buf));

				if (strlen(name_buf) > 0) {
					float dex = (float)atof(dex_buf);
					char dex_fmt[16];
					sprintf_s(dex_fmt, sizeof(dex_fmt), "%.1f", dex);
					if (strcmp(dex_fmt, dex_buf) != 0) {
						MessageBox(hwnd, "Dexterity must be in nn.n format.", "Invalid Input", MB_ICONWARNING);
						SetFocus(state->hwnd_dex);
						SendMessage(state->hwnd_dex, EM_SETSEL, 0, -1);
						return 0;
					}

					strcpy_s(state->data->name, MAX_NAME_LENGTH, name_buf);
					state->data->initiative = atoi(init_buf);
					state->data->dexterity = dex;
					state->result = IDOK;
					state->done = TRUE;
					PostMessage(hwnd, WM_CLOSE, 0, 0);
				} else {
					MessageBox(hwnd, "Please enter a creature name", "Invalid Input", MB_ICONWARNING);
					SetFocus(state->hwnd_name);
				}
				return 0;
			}
			else if (control_id == IDCANCEL) {
				state->result = IDCANCEL;
				state->done = TRUE;
				PostMessage(hwnd, WM_CLOSE, 0, 0);
				return 0;
			}
			break;
		}

		case WM_CLOSE:
			DestroyWindow(hwnd);
			return 0;

		case WM_CTLCOLORDLG:
		case WM_CTLCOLORLISTBOX:
		case WM_CTLCOLOREDIT:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_ERASEBKGND: {
			RECT rc;
			GetClientRect(hwnd, &rc);
			FillRect((HDC)wParam, &rc, g_brush_bg);
			return 1;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			break;
		}
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

LRESULT CALLBACK DurationDialogProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {

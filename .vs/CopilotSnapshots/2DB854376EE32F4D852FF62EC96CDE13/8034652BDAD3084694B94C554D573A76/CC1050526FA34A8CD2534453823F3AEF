void ui_init_dark_mode(void) {
	if (g_brush_bg) return;

	g_brush_bg = CreateSolidBrush(DARK_BG_COLOR);
	g_brush_button = CreateSolidBrush(DARK_BUTTON_COLOR);
	g_brush_active = CreateSolidBrush(DARK_ACTIVE_COLOR);

	LOGFONT lf;
	ZeroMemory(&lf, sizeof(LOGFONT));
	lf.lfHeight = -11;
	lf.lfWeight = FW_NORMAL;
	strcpy_s(lf.lfFaceName, LF_FACESIZE, "Segoe UI");
	g_font = CreateFontIndirect(&lf);
	lf.lfWeight = FW_BOLD;
	g_font_bold = CreateFontIndirect(&lf);
}

void ui_cleanup_dark_mode(void) {
	if (g_brush_bg) { DeleteObject(g_brush_bg); g_brush_bg = NULL; }
	if (g_brush_button) { DeleteObject(g_brush_button); g_brush_button = NULL; }
	if (g_brush_active) { DeleteObject(g_brush_active); g_brush_active = NULL; }
	if (g_font) { DeleteObject(g_font); g_font = NULL; }
	if (g_font_bold) { DeleteObject(g_font_bold); g_font_bold = NULL; }
}

static BOOL CALLBACK ui_capture_control_layout_proc(HWND hwnd_child, LPARAM lParam) {
	HWND hwnd_parent = (HWND)lParam;
	if (g_layout_control_count >= MAX_LAYOUT_CONTROLS) return FALSE;

	RECT rc;
	if (!GetWindowRect(hwnd_child, &rc)) return TRUE;
	MapWindowPoints(NULL, hwnd_parent, (LPPOINT)&rc, 2);

	g_layout_controls[g_layout_control_count].hwnd = hwnd_child;
	g_layout_controls[g_layout_control_count].base_rect = rc;
	g_layout_control_count++;
	return TRUE;
}

static void ui_capture_layout(HWND hwnd_parent) {
	RECT client_rc;
	if (!GetClientRect(hwnd_parent, &client_rc)) return;

	g_layout_base_width = client_rc.right - client_rc.left;
	g_layout_base_height = client_rc.bottom - client_rc.top;
	g_layout_control_count = 0;
	EnumChildWindows(hwnd_parent, ui_capture_control_layout_proc, (LPARAM)hwnd_parent);
}

static void ui_apply_layout(HWND hwnd_parent, int new_width, int new_height) {
	if (g_layout_base_width <= 0 || g_layout_base_height <= 0 || g_layout_control_count <= 0) return;
	if (new_width <= 0 || new_height <= 0) return;

	for (int i = 0; i < g_layout_control_count; i++) {
		if (!IsWindow(g_layout_controls[i].hwnd)) continue;

		RECT rc = g_layout_controls[i].base_rect;
		int x = MulDiv(rc.left, new_width, g_layout_base_width);
		int y = MulDiv(rc.top, new_height, g_layout_base_height);
		int w = MulDiv(rc.right - rc.left, new_width, g_layout_base_width);
		int h = MulDiv(rc.bottom - rc.top, new_height, g_layout_base_height);

		if (w < 20) w = 20;
		if (h < 16) h = 16;
		MoveWindow(g_layout_controls[i].hwnd, x, y, w, h, TRUE);
	}
}


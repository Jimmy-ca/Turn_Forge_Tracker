static void ui_mark_current_roll_line_used(HWND hwnd_roll_results) {
	if (!hwnd_roll_results) return;

	CHARRANGE current_sel;
	SendMessage(hwnd_roll_results, EM_EXGETSEL, 0, (LPARAM)&current_sel);

	int line = (int)SendMessage(hwnd_roll_results, EM_EXLINEFROMCHAR, 0, current_sel.cpMin);
	int line_start = (int)SendMessage(hwnd_roll_results, EM_LINEINDEX, line, 0);
	if (line_start < 0) return;

	int line_len = (int)SendMessage(hwnd_roll_results, EM_LINELENGTH, line_start, 0);
	if (line_len <= 0) return;

	char line_text[4096];
	*((WORD*)line_text) = (WORD)(sizeof(line_text) - 1);
	LRESULT copied = SendMessage(hwnd_roll_results, EM_GETLINE, line, (LPARAM)line_text);
	if (copied < 0) return;
	line_text[copied] = '\0';

	if (strstr(line_text, " USED") != NULL) {
		return;
	}

	CHARRANGE insert_sel;
	insert_sel.cpMin = line_start + line_len;
	insert_sel.cpMax = line_start + line_len;
	SendMessage(hwnd_roll_results, EM_EXSETSEL, 0, (LPARAM)&insert_sel);

	CHARFORMAT2A cf_used = { 0 };
	cf_used.cbSize = sizeof(cf_used);
	cf_used.dwMask = CFM_COLOR | CFM_BOLD;
	cf_used.dwEffects = CFE_BOLD;
	cf_used.crTextColor = RGB(139, 0, 0);
	SendMessage(hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_used);
	SendMessage(hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)" USED");

	CHARFORMAT2A cf_default = { 0 };
	cf_default.cbSize = sizeof(cf_default);
	cf_default.dwMask = CFM_COLOR | CFM_BOLD;
	cf_default.dwEffects = 0;
	cf_default.crTextColor = DARK_FG_COLOR;
	SendMessage(hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_default);
}

static void ui_draw_rounded_button(const DRAWITEMSTRUCT* dis) {
	if (!dis) return;

	RECT rc = dis->rcItem;
	HDC hdc = dis->hDC;
	BOOL pressed = (dis->itemState & ODS_SELECTED) != 0;
	BOOL focused = (dis->itemState & ODS_FOCUS) != 0;
	BOOL disabled = (dis->itemState & ODS_DISABLED) != 0;

	COLORREF fill_color = disabled ? RGB(50, 50, 50) : (pressed ? DARK_ACTIVE_COLOR : DARK_BUTTON_COLOR);
	int ctrl_id = GetDlgCtrlID(dis->hwndItem);
	BOOL is_bottom_action = (ctrl_id == ID_SAVE_BUTTON || ctrl_id == ID_LOAD_BUTTON || ctrl_id == ID_INFO_BUTTON);
	COLORREF border_color = is_bottom_action ? RGB(0, 200, 120) : RGB(255, 64, 64);
	COLORREF text_color = disabled ? RGB(130, 130, 130) : DARK_FG_COLOR;
	int arc_size = rc.bottom - rc.top;

	FillRect(hdc, &rc, g_brush_bg ? g_brush_bg : (HBRUSH)(COLOR_BTNFACE + 1));

	HPEN pen = CreatePen(PS_SOLID, 1, border_color);
	HBRUSH brush = CreateSolidBrush(fill_color);
	HGDIOBJ old_pen = SelectObject(hdc, pen);
	HGDIOBJ old_brush = SelectObject(hdc, brush);
	int old_bk_mode = SetBkMode(hdc, TRANSPARENT);
	COLORREF old_text_color = SetTextColor(hdc, text_color);

	RoundRect(hdc, rc.left, rc.top, rc.right, rc.bottom, arc_size, arc_size);

	char text[128] = "";
	GetWindowText(dis->hwndItem, text, sizeof(text));
	RECT text_rect = rc;
	if (pressed) {
		OffsetRect(&text_rect, 1, 1);
	}
	DrawText(hdc, text, -1, &text_rect, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

	if (focused && !disabled) {
		RECT focus_rect = rc;
		InflateRect(&focus_rect, -4, -4);
		DrawFocusRect(hdc, &focus_rect);
	}

	SetTextColor(hdc, old_text_color);
	SetBkMode(hdc, old_bk_mode);
	SelectObject(hdc, old_brush);
	SelectObject(hdc, old_pen);
	DeleteObject(brush);
	DeleteObject(pen);
}

void ui_update_initiative_list(void) {
	AppState* app = &g_app_state;
	if (!app->hwnd_initiative_list || !app->encounter) return;

	SendMessage(app->hwnd_initiative_list, LB_RESETCONTENT, 0, 0);

	for (int i = 0; i < app->encounter->creature_count; i++) {
		Creature* c = &app->encounter->creatures[i];
		SendMessage(app->hwnd_initiative_list, LB_ADDSTRING, 0, (LPARAM)c->name);
	}
}

static int ui_get_display_creature_index(AppState* app) {
	if (!app || !app->encounter) return -1;
	if (app->selected_creature_idx >= 0 && app->selected_creature_idx < app->encounter->creature_count) {
		return app->selected_creature_idx;
	}
	if (app->encounter->current_turn_index >= 0 && app->encounter->current_turn_index < app->encounter->creature_count) {
		return app->encounter->current_turn_index;
	}
	return -1;
}

static void ui_save_creature_at_index(AppState* app, int creature_idx) {
	if (!app || !app->encounter) return;
	if (creature_idx < 0 || creature_idx >= app->encounter->creature_count) return;
	creature_save_to_json(&app->encounter->creatures[creature_idx]);
}

static void ui_save_all_creatures(AppState* app) {
	if (!app || !app->encounter) return;
	for (int i = 0; i < app->encounter->creature_count; i++) {
		creature_save_to_json(&app->encounter->creatures[i]);
	}
}

static int ui_load_effects_db(EffectsDatabase* db) {
	if (!db) return -1;

	const char* candidates[] = {
		"resources\\effects.json",
		"..\\resources\\effects.json",
		"..\\..\\resources\\effects.json",
		"..\\..\\..\\resources\\effects.json"
	};

	for (int i = 0; i < (int)(sizeof(candidates) / sizeof(candidates[0])); i++) {
		int loaded = effects_db_load_from_json(db, candidates[i]);
		if (loaded > 0) {
			return loaded;
		}
	}

	return -1;
}

void ui_update_effects_list(void) {
	AppState* app = &g_app_state;
	if (!app->hwnd_effects_list || !app->encounter) return;

	SendMessage(app->hwnd_effects_list, LB_RESETCONTENT, 0, 0);

	int creature_idx = ui_get_display_creature_index(app);
	if (creature_idx < 0) return;

	Creature* c = &app->encounter->creatures[creature_idx];
	char header[512];
	sprintf_s(header, sizeof(header), "%s", c->name);
	SendMessage(app->hwnd_effects_list, LB_ADDSTRING, 0, (LPARAM)header);

	for (int i = 0; i < c->effect_count; i++) {
		char buffer[512];
		sprintf_s(buffer, sizeof(buffer), "%s (%d rounds)", c->effects[i].name, c->effects[i].duration);
		SendMessage(app->hwnd_effects_list, LB_ADDSTRING, 0, (LPARAM)buffer);
	}

	SendMessage(app->hwnd_effects_list, LB_SETCURSEL, 0, 0);
}


	}

	return state.result;
}

LRESULT CALLBACK MainWindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	AppState* app = &g_app_state;

	switch (msg) {
		case WM_CREATE:
			ui_create_controls(hwnd);
			ui_capture_layout(hwnd);
			ui_update_round_label();
			ui_update_initiative_list();
			ui_update_effects_list();
			return 0;

		case WM_NOTIFY: {
			NMHDR* hdr = (NMHDR*)lParam;
			if (hdr && hdr->idFrom == 3002 && hdr->code == EN_MSGFILTER) {
				MSGFILTER* mf = (MSGFILTER*)lParam;
				if (mf->msg == WM_LBUTTONDBLCLK) {
					ui_mark_current_roll_line_used(app->hwnd_roll_results);
					return 0;
				}
			}
			break;
		}

		case WM_COMMAND: {
			int control_id = LOWORD(wParam);
			int notification = HIWORD(wParam);

			if (notification == LBN_SELCHANGE && control_id == 2001) {
				int sel = (int)SendMessage(app->hwnd_initiative_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR) {
					app->selected_creature_idx = sel;
					ui_update_effects_list();
				}
				return 0;
			}

			if (notification == LBN_DBLCLK && control_id == 2001) {
				int sel = (int)SendMessage(app->hwnd_initiative_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR && app->encounter && sel < app->encounter->creature_count) {
					Creature* c = &app->encounter->creatures[sel];
					CreatureDialogData dialog_data;
					strcpy_s(dialog_data.name, MAX_NAME_LENGTH, c->name);
					dialog_data.initiative = c->initiative;
					dialog_data.dexterity = c->dexterity;
					dialog_data.edit_mode = 1;
					dialog_data.creature_idx = sel;

					if (show_creature_dialog(hwnd, &dialog_data) == IDOK) {
						strcpy_s(c->name, MAX_NAME_LENGTH, dialog_data.name);
						c->initiative = dialog_data.initiative;
						c->dexterity = dialog_data.dexterity;
						ui_save_creature_at_index(app, sel);
						ui_update_initiative_list();
						ui_update_effects_list();
					}
				}
				return 0;
			}

			if (notification == LBN_DBLCLK && control_id == 2002) {
				int creature_idx = ui_get_display_creature_index(app);
				if (app->encounter && creature_idx >= 0 && creature_idx < app->encounter->creature_count) {
					int sel = (int)SendMessage(app->hwnd_effects_list, LB_GETCURSEL, 0, 0);
					if (sel != LB_ERR && sel > 0) {
						Creature* c = &app->encounter->creatures[creature_idx];
						int effect_idx = sel - 1;
						if (effect_idx >= 0 && effect_idx < c->effect_count) {
							char edited_name[MAX_EFFECT_NAME];
							int edited_duration = show_effect_edit_dialog(
								hwnd,
								c->effects[effect_idx].name,
								c->effects[effect_idx].duration,
								edited_name,
								sizeof(edited_name));
							if (edited_duration > 0) {
								strcpy_s(c->effects[effect_idx].name, MAX_NAME_LENGTH, edited_name);
								c->effects[effect_idx].duration = edited_duration;
								app->selected_creature_idx = creature_idx;
								ui_save_creature_at_index(app, creature_idx);
								ui_update_effects_list();
								ui_update_initiative_list();
							}
						}
					}
				}
				return 0;
			}

			switch (control_id) {
				case 1001:
					if (app->encounter) {
						encounter_next_turn(app->encounter);
						ui_save_all_creatures(app);
						ui_update_initiative_list();
						ui_update_round_label();
						ui_update_effects_list();
					}
					return 0;

				case 1002:
					if (app->encounter) {
						encounter_sort_by_initiative(app->encounter);
						ui_update_initiative_list();
						ui_update_effects_list();
					}
					return 0;

				case 1003:
					if (app->encounter) {
						CreatureDialogData dialog_data;
						strcpy_s(dialog_data.name, MAX_NAME_LENGTH, "New Creature");
						dialog_data.initiative = 10;
						dialog_data.dexterity = 0.0f;
						dialog_data.edit_mode = 0;
						dialog_data.creature_idx = -1;

						if (show_creature_dialog(hwnd, &dialog_data) == IDOK) {
							int added_idx = encounter_add_creature(app->encounter, dialog_data.name, dialog_data.initiative, dialog_data.dexterity);
							if (added_idx >= 0) {
								app->selected_creature_idx = added_idx;
								ui_save_creature_at_index(app, added_idx);
							}
							ui_update_initiative_list();
							ui_update_effects_list();
						}
					}
					return 0;

				case 1004: {
					int creature_idx = ui_get_display_creature_index(app);
					if (app->encounter && creature_idx >= 0 && creature_idx < app->encounter->creature_count) {
						if (!app->effects_db || app->effects_db->count <= 0) {
							MessageBox(hwnd, "No effects were loaded from effects.json.", "Effects Not Available", MB_ICONWARNING);
							return 0;
						}

						int selected_effects[MAX_EFFECT_TYPES];
						int selected_durations[MAX_EFFECT_TYPES];
						char selected_names[MAX_EFFECT_TYPES][MAX_EFFECT_NAME];
						int selected_count = show_effect_select_dialog(hwnd, app->effects_db, selected_effects, selected_durations, selected_names, MAX_EFFECT_TYPES);
						if (selected_count > 0) {
							Creature* c = &app->encounter->creatures[creature_idx];
							for (int i = 0; i < selected_count; i++) {
								const EffectDefinition* effect = effects_db_get_effect(app->effects_db, selected_effects[i]);
								if (effect) {
									const char* final_name = (selected_names[i][0] != '\0') ? selected_names[i] : effect->name;
									int duration = selected_durations[i] > 0 ? selected_durations[i] : effect->base_duration;
									creature_add_effect(c, final_name, duration);
								}
							}
							app->selected_creature_idx = creature_idx;
							ui_save_creature_at_index(app, creature_idx);
							ui_update_effects_list();
							ui_update_initiative_list();
						}
					}
					return 0;
				}

				case 1005: {
					int creature_idx = ui_get_display_creature_index(app);
					if (app->encounter && creature_idx >= 0 && creature_idx < app->encounter->creature_count) {
						int sel = (int)SendMessage(app->hwnd_effects_list, LB_GETCURSEL, 0, 0);
						if (sel != LB_ERR && sel > 0) {
							Creature* c = &app->encounter->creatures[creature_idx];
							creature_remove_effect(c, sel - 1);
							app->selected_creature_idx = creature_idx;
							ui_save_creature_at_index(app, creature_idx);
							ui_update_effects_list();
							ui_update_initiative_list();
						}
					}
					return 0;
				}

				case 1006: {
					char dice_type_str[16];
					char count_str[16];
					char mod_str[16];
					GetWindowText(app->hwnd_dice_type, dice_type_str, sizeof(dice_type_str));
					GetWindowText(app->hwnd_dice_count, count_str, sizeof(count_str));
					GetWindowText(app->hwnd_modifier, mod_str, sizeof(mod_str));

					int count = atoi(count_str);
					if (count <= 0) {
						count = 1;
						SetWindowText(app->hwnd_dice_count, "1");
					}
					if (count > 1000) {
						count = 1000;
						SetWindowText(app->hwnd_dice_count, "1000");
					}

					int modifier = atoi(mod_str);
					DiceType type = dice_type_from_string(dice_type_str);
					RollResult* result = roll_dice(type, count, modifier);

					if (result) {
						CHARFORMAT2A cf_base = { 0 };
						cf_base.cbSize = sizeof(cf_base);
						cf_base.dwMask = CFM_COLOR;
						cf_base.crTextColor = DARK_FG_COLOR;

						CHARFORMAT2A cf_yellow = { 0 };
						cf_yellow.cbSize = sizeof(cf_yellow);
						cf_yellow.dwMask = CFM_COLOR;
						cf_yellow.crTextColor = RGB(255, 215, 0);

						CHARFORMAT2A cf_green = { 0 };
						cf_green.cbSize = sizeof(cf_green);
						cf_green.dwMask = CFM_COLOR;
						cf_green.crTextColor = RGB(0, 255, 120);

						int existing_len = GetWindowTextLength(app->hwnd_roll_results);
						SendMessage(app->hwnd_roll_results, EM_SETSEL, existing_len, existing_len);
						if (existing_len > 0) {
							SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)"\r\n");
						}

						SendMessage(app->hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_base);
						char prefix[64];
						sprintf_s(prefix, sizeof(prefix), "%s ", dice_type_str);
						SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)prefix);

						for (int i = 0; i < result->count; i++) {
							char left_part[128];
							sprintf_s(left_part, sizeof(left_part), "[%d(+%d) = ", result->individual_rolls[i], result->modifier);
							SendMessage(app->hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_base);
							SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)left_part);

							char value_part[32];
							sprintf_s(value_part, sizeof(value_part), "%d", result->modified_rolls[i]);
							SendMessage(app->hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_yellow);
							SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)value_part);

							SendMessage(app->hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_base);
							SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)"] ");
						}

						SendMessage(app->hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_base);
						SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)"Total: ");

						char total_value[32];
						sprintf_s(total_value, sizeof(total_value), "%d", result->total);
						SendMessage(app->hwnd_roll_results, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf_green);
						SendMessage(app->hwnd_roll_results, EM_REPLACESEL, FALSE, (LPARAM)total_value);

						roll_result_destroy(result);
					}
					return 0;
				}
			}
			break;
		}

		case WM_SIZE:
			if (wParam != SIZE_MINIMIZED) {
				ui_apply_layout(hwnd, LOWORD(lParam), HIWORD(lParam));
				RedrawWindow(hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN);
			}
			return 0;

		case WM_DESTROY:
			g_layout_control_count = 0;
			g_layout_base_width = 0;
			g_layout_base_height = 0;
			PostQuitMessage(0);
			return 0;

		case WM_CTLCOLORDLG:
		case WM_CTLCOLORLISTBOX:
		case WM_CTLCOLOREDIT:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			if (dis && dis->CtlType == ODT_LISTBOX && dis->CtlID == 2001 && app->encounter) {
				if ((int)dis->itemID < 0 || (int)dis->itemID >= app->encounter->creature_count) return TRUE;

				Creature* c = &app->encounter->creatures[dis->itemID];
				HDC hdc = dis->hDC;
				RECT rc = dis->rcItem;
				BOOL is_selected = (dis->itemState & ODS_SELECTED) != 0;
				HBRUSH brush_bg = CreateSolidBrush(is_selected ? RGB(55, 55, 60) : DARK_BG_COLOR);
				FillRect(hdc, &rc, brush_bg);
				DeleteObject(brush_bg);

				SetBkMode(hdc, TRANSPARENT);
				SetTextColor(hdc, DARK_FG_COLOR);

				RECT name_rect = rc;
				name_rect.left += 6;
				name_rect.right -= 180;
				HFONT old_font = (HFONT)SelectObject(hdc, g_font ? g_font : GetStockObject(DEFAULT_GUI_FONT));
				DrawText(hdc, c->name, -1, &name_rect, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);

				char meta[256];
				sprintf_s(meta, sizeof(meta), "[Init: %d, Effects: %d", c->initiative, c->effect_count);
				RECT meta_rect = rc;
				meta_rect.left = name_rect.right;
				meta_rect.right -= 30;
				DrawText(hdc, meta, -1, &meta_rect, DT_RIGHT | DT_VCENTER | DT_SINGLELINE);

				RECT suffix_rect = rc;
				suffix_rect.right -= 6;
				suffix_rect.left = meta_rect.right;
				if ((int)dis->itemID == app->encounter->current_turn_index) {
					SetTextColor(hdc, RGB(0, 255, 120));
					SelectObject(hdc, g_font_bold ? g_font_bold : old_font);
					DrawText(hdc, " <-]", -1, &suffix_rect, DT_RIGHT | DT_VCENTER | DT_SINGLELINE);
				}
				else {
					SetTextColor(hdc, DARK_FG_COLOR);
					DrawText(hdc, "]", -1, &suffix_rect, DT_RIGHT | DT_VCENTER | DT_SINGLELINE);
				}

				SelectObject(hdc, old_font);
				if (is_selected) {
					DrawFocusRect(hdc, &rc);
				}
				return TRUE;
			}
			break;
		}

		case WM_ERASEBKGND: {
			RECT rc;
			GetClientRect(hwnd, &rc);
			FillRect((HDC)wParam, &rc, g_brush_bg);
			return 1;
		}

		case WM_PAINT: {
			PAINTSTRUCT ps;
			HDC hdc = BeginPaint(hwnd, &ps);
			RECT rc_client;
			GetClientRect(hwnd, &rc_client);
			int grip_size = 24;
			RECT rc_grip = {
				rc_client.right - grip_size,
				rc_client.bottom - grip_size,
				rc_client.right,
				rc_client.bottom
			};

			FillRect(hdc, &rc_grip, g_brush_bg);

			HPEN pen = CreatePen(PS_SOLID, 1, RGB(170, 170, 170));
			HGDIOBJ old_pen = SelectObject(hdc, pen);
			MoveToEx(hdc, rc_grip.left + 7, rc_grip.bottom - 1, NULL);
			LineTo(hdc, rc_grip.right - 1, rc_grip.top + 7);
			MoveToEx(hdc, rc_grip.left + 12, rc_grip.bottom - 1, NULL);
			LineTo(hdc, rc_grip.right - 1, rc_grip.top + 12);
			MoveToEx(hdc, rc_grip.left + 17, rc_grip.bottom - 1, NULL);
			LineTo(hdc, rc_grip.right - 1, rc_grip.top + 17);
			SelectObject(hdc, old_pen);
			DeleteObject(pen);

			EndPaint(hwnd, &ps);
			return 0;
		}
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

int ui_init_and_run(void) {
	AppState* app = &g_app_state;

	app->encounter = encounter_create();
	if (!app->encounter) return -1;

	app->effects_db = effects_db_create();
	if (!app->effects_db) {
		encounter_destroy(app->encounter);
		return -1;
	}

	if (ui_load_effects_db(app->effects_db) <= 0) {
		MessageBox(NULL, "Could not load resources\\effects.json from expected locations.", "Effects Load Error", MB_ICONWARNING);
	}

	app->selected_creature_idx = -1;

	ui_save_all_creatures(app);
	ui_init_dark_mode();
	LoadLibraryA("Msftedit.dll");

	WNDCLASS wc = { 0 };
	wc.lpfnWndProc = MainWindowProc;
	wc.lpszClassName = "TurnForgeTrackerClass";
	wc.hInstance = GetModuleHandle(NULL);
	wc.hCursor = LoadCursor(NULL, IDC_ARROW);
	wc.hbrBackground = g_brush_bg;

	if (!RegisterClass(&wc)) {
		return -1;
	}

	app->hwnd_main = CreateWindow("TurnForgeTrackerClass", "Turn Forge Tracker",
		WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN | WS_CLIPSIBLINGS, CW_USEDEFAULT, CW_USEDEFAULT, 700, 700,
		NULL, NULL, wc.hInstance, NULL);

	if (!app->hwnd_main) {
		return -1;
	}

	ShowWindow(app->hwnd_main, SW_SHOW);
	UpdateWindow(app->hwnd_main);

	MSG msg;
	while (GetMessage(&msg, NULL, 0, 0)) {
		TranslateMessage(&msg);
		DispatchMessage(&msg);
	}

	if (app->encounter) encounter_destroy(app->encounter);
	if (app->effects_db) effects_db_destroy(app->effects_db);
	ui_cleanup_dark_mode();

	return 0;
}

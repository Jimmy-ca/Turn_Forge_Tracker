				WS_CHILD | WS_VISIBLE | WS_BORDER,
				75, 12, 160, 22, hwnd, (HMENU)ID_DURATION_NAME_EDIT, NULL, NULL);

			CreateWindow("STATIC", "Rounds:",
				WS_CHILD | WS_VISIBLE, 12, 44, 60, 20, hwnd, NULL, NULL, NULL);

			char duration_text[16];
			sprintf_s(duration_text, sizeof(duration_text), "%d", state->duration);
			state->hwnd_duration_edit = CreateWindow("EDIT", duration_text,
				WS_CHILD | WS_VISIBLE | WS_BORDER | ES_NUMBER,
				75, 42, 80, 22, hwnd, (HMENU)ID_DURATION_EDIT, NULL, NULL);

			CreateWindow("BUTTON", "OK",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW,
				62, 76, 60, 28, hwnd, (HMENU)ID_DURATION_OK, NULL, NULL);
			CreateWindow("BUTTON", "Cancel",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW,
				136, 76, 70, 28, hwnd, (HMENU)ID_DURATION_CANCEL, NULL, NULL);
			return 0;
		}

		case WM_COMMAND: {
			int id = LOWORD(wParam);
			if (id == ID_DURATION_OK) {
				char name_buf[MAX_EFFECT_NAME];
				GetWindowText(state->hwnd_name_edit, name_buf, sizeof(name_buf));
				if (strlen(name_buf) == 0) {
					MessageBox(hwnd, "Effect name cannot be empty.", "Invalid Name", MB_ICONWARNING);
					return 0;
				}

				char buf[16];
				GetWindowText(state->hwnd_duration_edit, buf, sizeof(buf));
				int value = atoi(buf);
				if (value <= 0) {
					MessageBox(hwnd, "Duration must be greater than 0.", "Invalid Duration", MB_ICONWARNING);
					return 0;
				}
				strcpy_s(state->effect_name, sizeof(state->effect_name), name_buf);
				state->duration = value;
				state->accepted = TRUE;
				state->done = TRUE;
				DestroyWindow(hwnd);
				return 0;
			}
			if (id == ID_DURATION_CANCEL) {
				state->accepted = FALSE;
				state->done = TRUE;
				DestroyWindow(hwnd);
				return 0;
			}
			break;
		}

		case WM_CTLCOLORDLG:
		case WM_CTLCOLOREDIT:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			break;
		}

		case WM_ERASEBKGND: {
			RECT rc;
			GetClientRect(hwnd, &rc);
			FillRect((HDC)wParam, &rc, g_brush_bg);
			return 1;
		}

		case WM_CLOSE:
			if (state) {
				state->accepted = FALSE;
				state->done = TRUE;
			}
			DestroyWindow(hwnd);
			return 0;
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

static int show_duration_dialog(HWND parent, const char* effect_name, int default_duration, char* out_name, size_t out_name_size) {
	static BOOL class_registered = FALSE;
	if (!class_registered) {
		WNDCLASS wc = { 0 };
		wc.lpfnWndProc = DurationDialogProc;
		wc.lpszClassName = "EffectDurationDialogClass";
		wc.hInstance = GetModuleHandle(NULL);
		wc.hCursor = LoadCursor(NULL, IDC_ARROW);
		wc.hbrBackground = g_brush_bg;
		RegisterClass(&wc);
		class_registered = TRUE;
	}

	DurationDialogState state;
	strcpy_s(state.effect_name, sizeof(state.effect_name), effect_name ? effect_name : "Effect");
	state.duration = default_duration > 0 ? default_duration : 1;
	state.done = FALSE;
	state.accepted = FALSE;
	state.hwnd_name_edit = NULL;
	state.hwnd_duration_edit = NULL;

	HWND hwnd_dialog = CreateWindowEx(WS_EX_DLGMODALFRAME,
		"EffectDurationDialogClass", "Edit Effect",
		WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU,
		400, 260, 270, 150,
		parent, NULL, GetModuleHandle(NULL), &state);
	if (!hwnd_dialog) return -1;

	ShowWindow(hwnd_dialog, SW_SHOW);
	UpdateWindow(hwnd_dialog);

	MSG msg;
	while (!state.done && GetMessage(&msg, NULL, 0, 0)) {
		if (msg.hwnd == hwnd_dialog || IsChild(hwnd_dialog, msg.hwnd)) {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}
		else {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}
	}

	if (!state.accepted) return -1;
	if (out_name && out_name_size > 0) {
		strcpy_s(out_name, out_name_size, state.effect_name);
	}
	return state.duration;
}

static int show_effect_edit_dialog(HWND parent, const char* initial_name, int default_duration, char* out_name, size_t out_name_size) {
	return show_duration_dialog(parent, initial_name, default_duration, out_name, out_name_size);
}

LRESULT CALLBACK EffectSelectDialogProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	EffectSelectDialogState* state = (EffectSelectDialogState*)GetWindowLongPtr(hwnd, GWLP_USERDATA);

	switch (msg) {
		case WM_CREATE: {
			CREATESTRUCT* cs = (CREATESTRUCT*)lParam;
			state = (EffectSelectDialogState*)cs->lpCreateParams;
			SetWindowLongPtr(hwnd, GWLP_USERDATA, (LONG_PTR)state);

			state->selected_count = 0;
			state->hwnd_list = CreateWindow("LISTBOX", "",
				WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | LBS_NOTIFY | LBS_MULTIPLESEL | LBS_NOINTEGRALHEIGHT,
				10, 10, 300, 250, hwnd, (HMENU)ID_EFFECTS_LIST_SELECT, NULL, NULL);

			CreateWindow("BUTTON", "OK",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW,
				90, 270, 60, 28, hwnd, (HMENU)ID_EFFECTS_OK, NULL, NULL);
			CreateWindow("BUTTON", "Cancel",
				WS_CHILD | WS_VISIBLE | BS_OWNERDRAW,
				170, 270, 80, 28, hwnd, (HMENU)ID_EFFECTS_CANCEL, NULL, NULL);

			if (state->db) {
				for (int i = 0; i < state->db->count; i++) {
					SendMessage(state->hwnd_list, LB_ADDSTRING, 0, (LPARAM)state->db->effects[i].name);
				}
			}
			return 0;
		}

		case WM_COMMAND: {
			int control_id = LOWORD(wParam);
			int notify = HIWORD(wParam);

			if (control_id == ID_EFFECTS_CANCEL) {
				state->accepted = FALSE;
				state->done = TRUE;
				DestroyWindow(hwnd);
				return 0;
			}
			if (control_id == ID_EFFECTS_OK) {
				int sel_count = (int)SendMessage(state->hwnd_list, LB_GETSELCOUNT, 0, 0);
				if (sel_count > 0) {
					if (sel_count > MAX_EFFECT_TYPES) sel_count = MAX_EFFECT_TYPES;
					state->selected_count = (int)SendMessage(state->hwnd_list, LB_GETSELITEMS, (WPARAM)sel_count, (LPARAM)state->selected_indices);
					if (state->selected_count > 0) {
						for (int i = 0; i < state->selected_count; i++) {
							int idx = state->selected_indices[i];
							if (state->selected_durations[idx] <= 0 && state->db && idx < state->db->count) {
								const EffectDefinition* effect = effects_db_get_effect(state->db, idx);
								state->selected_durations[idx] = effect ? effect->base_duration : 1;
							}
						}
						state->accepted = TRUE;
						state->done = TRUE;
						DestroyWindow(hwnd);
						return 0;
					}
				}
				MessageBox(hwnd, "Select one or more effects first.", "No Effects Selected", MB_ICONWARNING);
				return 0;
			}
			if (control_id == ID_EFFECTS_LIST_SELECT && notify == LBN_DBLCLK) {
				int sel = (int)SendMessage(state->hwnd_list, LB_GETCURSEL, 0, 0);
				if (sel != LB_ERR && state->db && sel < state->db->count) {
					const EffectDefinition* effect = effects_db_get_effect(state->db, sel);
					if (effect) {
						char edited_name[MAX_EFFECT_NAME];
						const char* current_name = state->selected_names[sel][0] != '\0' ? state->selected_names[sel] : effect->name;
						int current_duration = state->selected_durations[sel] > 0 ? state->selected_durations[sel] : effect->base_duration;
						int edited_duration = show_effect_edit_dialog(hwnd, current_name, current_duration, edited_name, sizeof(edited_name));
						if (edited_duration > 0) {
							state->selected_durations[sel] = edited_duration;
							strcpy_s(state->selected_names[sel], sizeof(state->selected_names[sel]), edited_name);
							SendMessage(state->hwnd_list, LB_DELETESTRING, (WPARAM)sel, 0);
							SendMessage(state->hwnd_list, LB_INSERTSTRING, (WPARAM)sel, (LPARAM)edited_name);
							SendMessage(state->hwnd_list, LB_SETSEL, TRUE, (LPARAM)sel);
							SendMessage(state->hwnd_list, LB_SETCURSEL, (WPARAM)sel, 0);
						}
					}
				}
				return 0;
			}
			break;
		}

		case WM_CTLCOLORLISTBOX:
		case WM_CTLCOLORDLG:
		case WM_CTLCOLORSTATIC: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BG_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_bg;
		}

		case WM_CTLCOLORBTN: {
			HDC hdc = (HDC)wParam;
			SetBkColor(hdc, DARK_BUTTON_COLOR);
			SetTextColor(hdc, DARK_FG_COLOR);
			return (LRESULT)g_brush_button;
		}

		case WM_DRAWITEM: {
			const DRAWITEMSTRUCT* dis = (const DRAWITEMSTRUCT*)lParam;
			if (dis && dis->CtlType == ODT_BUTTON) {
				ui_draw_rounded_button(dis);
				return TRUE;
			}
			break;
		}

		case WM_CLOSE:
			if (state) {
				state->accepted = FALSE;
				state->done = TRUE;
			}
			g_effect_select_open = FALSE;
			g_effect_select_hwnd = NULL;
			DestroyWindow(hwnd);
			return 0;
	}

	return DefWindowProc(hwnd, msg, wParam, lParam);
}

static int show_effect_select_dialog(HWND parent, EffectsDatabase* db, int* selected_indices, int* selected_durations, char selected_names[][MAX_EFFECT_NAME], int max_selected) {
	static BOOL class_registered = FALSE;
	if (g_effect_select_open && g_effect_select_hwnd && IsWindow(g_effect_select_hwnd)) {
		ShowWindow(g_effect_select_hwnd, SW_SHOWNORMAL);
		SetForegroundWindow(g_effect_select_hwnd);
		return -1;
	}
	if (!class_registered) {
		WNDCLASS wc = { 0 };
		wc.lpfnWndProc = EffectSelectDialogProc;
		wc.lpszClassName = "EffectSelectDialogClass";
		wc.hInstance = GetModuleHandle(NULL);
		wc.hCursor = LoadCursor(NULL, IDC_ARROW);
		wc.hbrBackground = g_brush_bg;
		RegisterClass(&wc);
		class_registered = TRUE;
	}

	EffectSelectDialogState state;
	state.db = db;
	state.selected_count = 0;
	state.done = FALSE;
	state.accepted = FALSE;
	state.hwnd_list = NULL;
	for (int i = 0; i < MAX_EFFECT_TYPES; i++) {
		state.selected_durations[i] = 0;
		state.selected_names[i][0] = '\0';
	}

	HWND hwnd_dialog = CreateWindowEx(WS_EX_DLGMODALFRAME,
		"EffectSelectDialogClass", "Select Effect",
		WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU,
		350, 220, 340, 350,
		parent, NULL, GetModuleHandle(NULL), &state);

	if (!hwnd_dialog) return -1;

	g_effect_select_open = TRUE;
	g_effect_select_hwnd = hwnd_dialog;

	ShowWindow(hwnd_dialog, SW_SHOW);
	UpdateWindow(hwnd_dialog);

	MSG msg;
	while (!state.done && GetMessage(&msg, NULL, 0, 0)) {
		if (msg.hwnd == hwnd_dialog || IsChild(hwnd_dialog, msg.hwnd)) {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}
		else {
			TranslateMessage(&msg);
			DispatchMessage(&msg);
		}
	}

	if (!state.accepted || !selected_indices || !selected_durations || !selected_names || max_selected <= 0) return -1;

	int out_count = state.selected_count;
	if (out_count > max_selected) out_count = max_selected;
	for (int i = 0; i < out_count; i++) {
		int idx = state.selected_indices[i];
		selected_indices[i] = idx;
		selected_durations[i] = state.selected_durations[idx];
		if (state.selected_names[idx][0] != '\0') {
			strcpy_s(selected_names[i], MAX_EFFECT_NAME, state.selected_names[idx]);
		} else if (state.db && idx >= 0 && idx < state.db->count) {
			strcpy_s(selected_names[i], MAX_EFFECT_NAME, state.db->effects[idx].name);
		} else {
			selected_names[i][0] = '\0';
		}
	}
	return out_count;
}

int show_creature_dialog(HWND parent, CreatureDialogData* data) {
	static BOOL class_registered = FALSE;

	if (!class_registered) {
		WNDCLASS wc = { 0 };

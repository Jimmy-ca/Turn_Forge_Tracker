<Window x:Class="TurnForgeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TurnForgeTracker.ViewModels"
        Title="Turn Forge Tracker"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Active row highlight trigger -->
        <Style x:Key="CombatantRowStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1e3a5a"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGoldBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182d4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Effect chip style -->
        <Style x:Key="EffectChip" TargetType="Border">
            <Setter Property="Background" Value="#2a3a5a"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="*"/>
            <!-- main content -->
            <RowDefinition Height="Auto"/>
            <!-- effects panel -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}" CornerRadius="8" Padding="20,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚔" FontSize="28" Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Turn Forge Tracker"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentGoldBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="Round" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{StaticResource BackgroundPanelBrush}" CornerRadius="20" Padding="14,4">
                        <TextBlock Text="{Binding CurrentRound}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <!-- combatant list -->
                <ColumnDefinition Width="12"/>
                <!-- gutter -->
                <ColumnDefinition Width="*"/>
                <!-- controls -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Combatant List ───────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Combatants" Style="{StaticResource SectionHeader}"/>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="2" Text="Init" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="HP" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Effects" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" Margin="8,6,0,2"/>
                        <TextBlock Grid.Column="5" Text="" Style="{StaticResource FieldLabel}"/>
                    </Grid>

                    <!-- Combatant rows -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Combatants}"
                             SelectedItem="{Binding ActiveCombatant, Mode=OneWay}"
                             ItemContainerStyle="{StaticResource CombatantRowStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,6" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#1b3a28"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Active indicator -->
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="▶"/>
                                                            <Setter Property="Foreground" Value="{StaticResource ActiveGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Foreground="{StaticResource TextLightBrush}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Initiative -->
                                        <Border Grid.Column="2" Background="{StaticResource BackgroundPanelBrush}"
                                                CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initiative}"
                                                       Foreground="{StaticResource AccentGoldBrush}"
                                                       FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- HP -->
                                        <TextBlock Grid.Column="3" Text="{Binding HpDisplay}"
                                                   Foreground="{StaticResource ActiveGreenBrush}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Effects summary -->
                                        <TextBlock Grid.Column="4" Text="{Binding EffectsSummary}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                                                   ToolTip="{Binding EffectsSummary}"/>

                                        <!-- Remove button -->
                                        <Button Grid.Column="5"
                                                Content="✕"
                                                Command="{Binding DataContext.RemoveCombatantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                Padding="4,2"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── RIGHT: Controls ───────────────────────────────────────── -->
            <StackPanel Grid.Column="2">

                <!-- Add Combatant card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Add Combatant" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewCombatantName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Initiative" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewCombatantInitiative, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Max HP" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewCombatantHp, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="＋  Add Combatant"
                                Command="{Binding AddCombatantCommand}"
                                Style="{StaticResource GoldButton}"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Turn controls card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Turn Controls" Style="{StaticResource SectionHeader}"/>

                        <Button Content="▶  Next Turn"
                                Command="{Binding NextTurnCommand}"
                                Style="{StaticResource GoldButton}"
                                HorizontalAlignment="Stretch"
                                FontSize="15"
                                Padding="14,10"
                                Margin="0,0,0,8"/>

                        <Button Content="↺  Reset Combat"
                                Command="{Binding ResetCombatCommand}"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Stretch"
                                FontSize="13"
                                Padding="14,8"/>
                    </StackPanel>
                </Border>

                <!-- Active combatant info -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Active Turn" Style="{StaticResource SectionHeader}"/>
                        <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ActiveCombatant.Name}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ActiveGreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveCombatant}" Value="{x:Null}">
                                            <Setter Property="Text" Value="No combat started"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ EFFECTS PANEL ════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Active effects list -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Effects on: " Style="{StaticResource SectionHeader}" Margin="0"/>
                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,8"
                                   VerticalAlignment="Bottom">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ActiveGreenBrush}"/>
                                    <Setter Property="Text" Value="{Binding ActiveCombatant.Name}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveCombatant}" Value="{x:Null}">
                                            <Setter Property="Text" Value="(select a combatant)"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ActiveCombatant.Effects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EffectChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextLightBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DurationDisplay}"
                                                   Foreground="{StaticResource AccentGoldBrush}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content=" ✕"
                                                Command="{Binding DataContext.RemoveEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                Foreground="{StaticResource DangerRedBrush}"
                                                BorderThickness="0"
                                                FontSize="10"
                                                Padding="2,0"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No effects active"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" FontStyle="Italic" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCombatant.Effects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveCombatant}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Add effect form -->
                <Border Grid.Column="1" Background="#0d1b38" CornerRadius="6" Padding="12,8" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Effect:" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewEffectName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="130" VerticalAlignment="Center"
                                 ToolTip="Effect name (e.g. Poisoned, Stunned)"/>
                        <TextBlock Text="Rounds:" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <TextBox Text="{Binding NewEffectDuration, UpdateSourceTrigger=PropertyChanged}"
                                 Width="50" VerticalAlignment="Center"
                                 ToolTip="Duration in rounds. Use -1 for permanent."/>
                        <Button Content="＋ Add Effect"
                                Command="{Binding AddEffectCommand}"
                                Style="{StaticResource GoldButton}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
